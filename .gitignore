# Dependencies
node_modules/
**/node_modules/

# Next.js / build output
.next/
**/.next/
out/
dist/
build/
coverage/

# Environment files — templates stay, real values never commit.
# (Keep these exceptions LAST: they must win over the patterns above.)
.env
.env.*
!.env.example
!.env.local.example

# Databases (SQLite / local files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# User uploads — never commit user files
uploads/
**/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel/

# Misc
.DS_Store
*.pem
*.tsbuildinfo
