# Supabase Configuration (Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS — comma list of allowed browser origins. Wildcards allowed for
# Vercel previews, e.g. https://your-app-git-*.vercel.app
CORS_ORIGIN=http://localhost:3100
WEB_BASE_URL=http://localhost:3100

# Email (Resend) — from must be a verified domain in production
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Literacy Gardeners <onboarding@resend.dev>

# Store
ORDER_SHIPPING_FEE=0

# Port
PORT=4000
